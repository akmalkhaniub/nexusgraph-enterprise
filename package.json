{
  "name": "nexusgraph-enterprise",
  "version": "1.0.0",
  "description": "Enterprise Semantic Knowledge Graph & Multi-Hop Reasoning Fabric for Galuxium Nexus V2",
  "main": "src/knowledge_graph_engine.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/verify_nexusgraph.js",
    "docker:build": "docker build -t nexusgraph-enterprise:latest .",
    "docker:run": "docker run -d -p 3006:3006 --name nexusgraph-enterprise nexusgraph-enterprise:latest",
    "docker:compose": "docker compose up -d",
    "tunnel": "powershell -ExecutionPolicy Bypass -File deploy/free/tunnel.ps1"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {},
  "keywords": [
    "knowledge-graph",
    "graphrag",
    "enterprise",
    "multi-hop",
    "neo4j",
    "vector-search",
    "provenance"
  ],
  "author": "Antigravity Builder",
  "license": "MIT"
}
