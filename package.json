{
  "name": "nexusgraph-enterprise",
  "version": "1.0.0",
  "description": "Enterprise Semantic Knowledge Graph & Multi-Hop Reasoning Fabric for Galuxium Nexus V2",
  "main": "dist/knowledge_graph_engine.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run typecheck && tsx test/verify_nexusgraph.ts && tsx test/eval.test.ts && tsx test/server_integration.ts",
    "test:unit": "tsx test/verify_nexusgraph.ts",
    "test:integration": "tsx test/server_integration.ts",
    "docker:build": "docker build -t nexusgraph-enterprise:latest .",
    "docker:run": "docker run -d -p 3006:3006 --name nexusgraph-enterprise nexusgraph-enterprise:latest",
    "docker:compose": "docker compose up -d",
    "tunnel": "powershell -ExecutionPolicy Bypass -File deploy/free/tunnel.ps1",
    "test:eval": "tsx test/eval.test.ts",
    "eval": "tsx src/eval.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "knowledge-graph",
    "graphrag",
    "enterprise",
    "multi-hop",
    "neo4j",
    "vector-search",
    "provenance"
  ],
  "author": "Antigravity Builder",
  "license": "MIT"
}
